<Project Sdk="Beutl.Extensibility.Sdk/2.0.0-preview.8">

    <PropertyGroup>
        <PackageId>Beutl.Extensions.Karaoke</PackageId>
        <Title>カラオケ字幕</Title>
        <Description>LRCファイルを読み込み、歌詞の色が単語ごとに塗り替わるカラオケ風の字幕を生成します</Description>
        <PackageTags>caption,lyrics,karaoke,lrc,歌詞,カラオケ</PackageTags>
        <Version>0.1.0</Version>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <Authors>Yuto Terada</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <BeutlAutoReferenceSourceGenerators>false</BeutlAutoReferenceSourceGenerators>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Beutl.Engine.SourceGenerators"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            Version="2.0.0-preview.8"
            PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Beutl.Extensions.Karaoke.Tests" />
    </ItemGroup>


    <ItemGroup>
        <!-- The icons Beutl's own tool tabs use. Beutl ships these assemblies, so compile against the same version
             and leave them, and what they pull in (such as native SkiaSharp), out of the output: at run time the
             extension uses Beutl's copies. Same exclusion as the SDK applies to the Beutl packages. -->
        <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.1.343" ExcludeAssets="runtime;native" PrivateAssets="all" />
        <PackageReference Include="FluentIcons.Common" Version="2.1.343" ExcludeAssets="runtime;native" PrivateAssets="all" />
        <PackageReference Include="FluentIcons.Resources.Avalonia" Version="2.1.343" ExcludeAssets="runtime;native" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
