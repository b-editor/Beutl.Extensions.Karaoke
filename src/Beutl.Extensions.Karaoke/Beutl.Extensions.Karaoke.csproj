<Project Sdk="Beutl.Extensibility.Sdk/2.0.0-preview.13">

    <PropertyGroup>
        <PackageId>Beutl.Extensions.Karaoke</PackageId>
        <Title>Karaoke subtitles</Title>
        <Description>Import LRC files and create karaoke subtitles that change color as the lyrics are sung.</Description>
        <PackageTags>caption,lyrics,karaoke,lrc,歌詞,カラオケ</PackageTags>
        <Version>0.1.5</Version>
        <AssemblyVersion>0.1.5.0</AssemblyVersion>
        <Authors>Yuto Terada</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <BeutlAutoReferenceSourceGenerators>false</BeutlAutoReferenceSourceGenerators>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Beutl.Engine.SourceGenerators"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            Version="2.0.0-preview.13"
            PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Beutl.Extensions.Karaoke.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Generate public resource properties for DisplayAttribute as part of every build. -->
        <EmbeddedResource Update="Localization/Strings.resx">
            <StronglyTypedLanguage>C#</StronglyTypedLanguage>
            <StronglyTypedNamespace>Beutl.Extensions.Karaoke.Localization</StronglyTypedNamespace>
            <StronglyTypedClassName>Strings</StronglyTypedClassName>
            <StronglyTypedFileName>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/Strings.Designer.cs</StronglyTypedFileName>
            <PublicClass>true</PublicClass>
        </EmbeddedResource>
    </ItemGroup>


    <ItemGroup>
        <!-- The icons Beutl's own tool tabs use. The SDK compiles against the version Beutl ships and leaves the
             library, and what it pulls in (such as native SkiaSharp), out of the output: at run time the extension
             uses Beutl's copies. -->
        <BeutlHostPackageReference Include="FluentIcons.Avalonia.Fluent" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
